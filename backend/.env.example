# Supabase → Project Settings → Database → Connection string (URI). Use the
# psycopg driver prefix. For local dev with `supabase start`, the default below works.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54322/postgres

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Supabase → Project Settings → API. Tokens are verified with the project's public JWKS.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only if the project still uses the legacy JWT secret (Settings → JWT Keys). Never commit it.
SUPABASE_JWT_SECRET=
