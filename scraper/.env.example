# Same database as the backend.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54322/postgres
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Gets flagged-row emails; also the contact address in the bot's user agent.
OWNER_EMAIL=
SCRAPER_MIN_DELAY=10
# Flagged-row emails go out through the backend's SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
