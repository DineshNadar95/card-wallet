{
  "openapi": "3.1.0",
  "info": {
    "title": "Card Wallet API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/catalog/cards": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Catalog Cards",
        "operationId": "list_catalog_cards",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "name": "no_annual_fee",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "No Annual Fee"
            }
          },
          {
            "name": "no_fx_fee",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "No Fx Fee"
            }
          },
          {
            "name": "rewards",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "cashback",
                    "travel"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Rewards"
            }
          },
          {
            "name": "credit_tier",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "const": "excellent",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Credit Tier"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/catalog/cards/{card_id}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Get Catalog Card",
        "operationId": "get_catalog_card",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Card Id"
            }
          }
        ],
