# Public values only (EXPO_PUBLIC_* is bundled into the app). Never put secrets here.
# On a physical phone, use your computer's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Supabase → Project Settings → API: project URL and the anon / publishable key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
